# Django application (set strong unique secrets in your untracked .env file)
DJANGO_SECRET_KEY=replace_with_a_random_secret
DJANGO_DEBUG=True
DJANGO_PUBLIC_BASE_URL=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_TRUST_PROXY_SSL_HEADER=False

# Local development uses SQLite. Set DB_HOST to use PostgreSQL.
DB_NAME=kerms_risk_register
DB_USER=kerms_app
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=
DB_CONN_MAX_AGE=60

# Email (console backend is the default until a provider is configured)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=risk-platform@example.com

# Local-only AI onboarding prototype; enabled by default only when DEBUG=True.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Claude (Anthropic) powers the production Quick risk check feature, which
# analyzes real business profiles. ANTHROPIC_API_KEY must be set for that
# feature to work in any environment, including production.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
DJANGO_AI_RISK_ANALYSIS_ENABLED=True

# Sign in with Google (optional; the button is hidden until both are set).
# Create credentials at https://console.cloud.google.com/apis/credentials
# with an Authorized redirect URI of <your-base-url>/accounts/google/login/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# KERMS onboarding and Premium subscription payments (Daraja STK Push)
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=https://your-public-host/payments/daraja/callback/
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline

# Uploaded/generated files (report downloads). Leave MEDIA_STORAGE_BUCKET empty
# to use the local media/ folder. In production, use an S3-compatible bucket
# (Cloudflare R2, AWS S3, Backblaze B2) because container disks are wiped on deploy.
# For R2, set the endpoint to https://<account-id>.r2.cloudflarestorage.com
MEDIA_STORAGE_BUCKET=
MEDIA_STORAGE_ENDPOINT_URL=
MEDIA_STORAGE_REGION=
MEDIA_STORAGE_ACCESS_KEY_ID=
MEDIA_STORAGE_SECRET_ACCESS_KEY=

# Error monitoring (optional). Errors are reported only when a DSN is set.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0
LOG_LEVEL=INFO

# Legacy M-Pesa prototype settings. Not used by the integrated Django API.
DATABASE_PATH=data/riskbot.sqlite3
PORT=5000
TIMEZONE=Africa/Nairobi
ALERT_HOUR=21
MAX_SINGLE_TRANSACTION_KES=100000
MAX_DAILY_PAYER_TOTAL_KES=250000
MAX_DAILY_PAYER_TRANSACTIONS=20
DASHBOARD_TOKEN=
WHATSAPP_PROVIDER=
OWNER_WHATSAPP_NUMBER=
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=
WATI_BASE_URL=
WATI_API_TOKEN=
REQUEST_TIMEOUT_SECONDS=15
