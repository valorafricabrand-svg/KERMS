# Django application (set strong unique secrets in your untracked .env file)
DJANGO_SECRET_KEY=replace_with_a_random_secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_TRUST_PROXY_SSL_HEADER=False

# Local development uses SQLite. Set DB_HOST to use PostgreSQL.
DB_NAME=cgs_risk_register
DB_USER=cgs_app
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=
DB_CONN_MAX_AGE=60

# Email (console backend is the default until a provider is configured)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=risk-platform@example.com

# Legacy M-Pesa prototype settings. Not used by the integrated Django API.
DATABASE_PATH=data/riskbot.sqlite3
PORT=5000
TIMEZONE=Africa/Nairobi
ALERT_HOUR=21
MAX_SINGLE_TRANSACTION_KES=100000
MAX_DAILY_PAYER_TOTAL_KES=250000
MAX_DAILY_PAYER_TRANSACTIONS=20
DASHBOARD_TOKEN=
WHATSAPP_PROVIDER=
OWNER_WHATSAPP_NUMBER=
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=
WATI_BASE_URL=
WATI_API_TOKEN=
REQUEST_TIMEOUT_SECONDS=15
